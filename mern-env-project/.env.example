# =============================================================================
# Environment Configuration Template (.env.example)
# =============================================================================
# Copy this file to '.env' and fill in actual secrets before starting:
#   cp .env.example .env
#
# DO NOT store real production passwords, API tokens, or secrets in this template!
# =============================================================================

# MongoDB Connection URI (service name 'mongo' for docker-compose, or localhost for local node)
MONGO_URI=mongodb://mongo:27017/mern_db

# Secret key for JWT signing (Minimum 32 characters recommended for HMAC SHA-256)
JWT_SECRET=your_super_secret_jwt_key_here

# Port on which the Express server listens
PORT=5000

# API key for service authorization
API_KEY=your_api_key_here
